 MkDocs \u548c GitHub Pages \u642d\u5efa\u535a\u5ba2          </li> </ul>"},{"location":"tags/#tag:python","title":"python","text":"<ul> <li>            \u6bcf\u4e2a\u5f00\u53d1\u8005\u90fd\u5e94\u8be5\u77e5\u9053\u7684 5 \u4e2a Python \u6280\u5de7          </li> </ul>"},{"location":"tags/#tag:\u6280\u5de7","title":"\u6280\u5de7","text":"<ul> <li>            \u6bcf\u4e2a\u5f00\u53d1\u8005\u90fd\u5e94\u8be5\u77e5\u9053\u7684 5 \u4e2a Python \u6280\u5de7          </li> </ul>"},{"location":"tags/#tag:\u6559\u7a0b","title":"\u6559\u7a0b","text":"<ul> <li>            \u7528 MkDocs \u548c GitHub Pages \u642d\u5efa\u535a\u5ba2          </li> </ul>"},{"location":"tags/#tag:\u9759\u6001\u7f51\u7ad9","title":"\u9759\u6001\u7f51\u7ad9","text":"<ul> <li>            \u4f60\u597d\u4e16\u754c\uff1a\u6211\u7684\u535a\u5ba2\u4e0a\u7ebf\u5566          </li> </ul>"},{"location":"blog/","title":"\u535a\u5ba2","text":""},{"location":"blog/2026/04/15/hello-world/","title":"\u4f60\u597d\u4e16\u754c\uff1a\u6211\u7684\u535a\u5ba2\u4e0a\u7ebf\u5566","text":"<p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u65b0\u535a\u5ba2\uff01\u8fd9\u662f\u6211\u4f7f\u7528 MkDocs \u548c Material \u4e3b\u9898\u642d\u5efa\u7684\u7b2c\u4e00\u7bc7\u6587\u7ae0\u3002</p>","tags":["mkdocs","markdown","\u9759\u6001\u7f51\u7ad9"]},{"location":"blog/2026/04/15/hello-world/#_2","title":"\u4e3a\u4ec0\u4e48\u9009\u62e9\u9759\u6001\u7f51\u7ad9\uff1f","text":"<p>\u9759\u6001\u7f51\u7ad9\u5feb\u901f\u3001\u5b89\u5168\u3001\u6613\u4e8e\u7ef4\u62a4\u3002\u65e0\u9700\u6570\u636e\u5e93\uff0c\u65e0\u9700\u670d\u52a1\u7aef\u4ee3\u7801\uff0c\u4e5f\u65e0\u9700\u62c5\u5fc3\u5b89\u5168\u8865\u4e01\u3002\u53ea\u9700\u7f16\u5199 Markdown\uff0c\u5269\u4e0b\u7684\u4ea4\u7ed9 MkDocs\u3002</p>","tags":["mkdocs","markdown","\u9759\u6001\u7f51\u7ad9"]},{"location":"blog/2026/04/15/hello-world/#_3","title":"\u6280\u672f\u6808","text":"<p>\u672c\u535a\u5ba2\u7531\u4ee5\u4e0b\u6280\u672f\u9a71\u52a8\uff1a</p> <ul> <li>MkDocs \u2014 \u7528 Python \u7f16\u5199\u7684\u9759\u6001\u7f51\u7ad9\u751f\u6210\u5668</li> <li>Material for MkDocs \u2014 \u7f8e\u89c2\u3001\u54cd\u5e94\u5f0f\u7684\u4e3b\u9898\uff0c\u5185\u7f6e\u535a\u5ba2\u63d2\u4ef6</li> <li>GitHub Pages \u2014 \u514d\u8d39\u6258\u7ba1\uff0c\u81ea\u52a8\u90e8\u7f72</li> </ul>","tags":["mkdocs","markdown","\u9759\u6001\u7f51\u7ad9"]},{"location":"blog/2026/04/15/hello-world/#_4","title":"\u540e\u7eed\u8ba1\u5212","text":"<p>\u63a5\u4e0b\u6765\u7684\u51e0\u5468\uff0c\u6211\u4f1a\u5199\u4ee5\u4e0b\u5185\u5bb9\uff1a</p> <ol> <li>Python \u6280\u5de7\u4e0e\u7a8d\u95e8</li> <li>Web \u5f00\u53d1\u6700\u4f73\u5b9e\u8df5</li> <li>DevOps \u4e0e\u90e8\u7f72\u7b56\u7565</li> </ol> <p>\u656c\u8bf7\u671f\u5f85\uff01</p>","tags":["mkdocs","markdown","\u9759\u6001\u7f51\u7ad9"]},{"location":"blog/2026/04/25/python-tips/","title":"\u6bcf\u4e2a\u5f00\u53d1\u8005\u90fd\u5e94\u8be5\u77e5\u9053\u7684 5 \u4e2a Python \u6280\u5de7","text":"<p>\u4ee5\u4e0b\u662f\u4e94\u4e2a\u80fd\u8ba9\u4f60\u7684\u4ee3\u7801\u66f4\u7b80\u6d01\u3001\u66f4\u9ad8\u6548\u7684 Python \u6280\u5de7\u3002</p>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/04/25/python-tips/#1","title":"1. \u4f7f\u7528\u5217\u8868\u63a8\u5bfc\u5f0f","text":"<pre><code># \u4ee5\u524d\u8fd9\u6837\u5199\uff1a\nsquares = []\nfor x in range(10):\n    squares.append(x**2)\n\n# \u73b0\u5728\u8fd9\u6837\u5199\uff1a\nsquares = [x**2 for x in range(10)]\n</code></pre>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/04/25/python-tips/#2-f-string","title":"2. \u5584\u7528 f-String","text":"<pre><code>name = \"\u4e16\u754c\"\nprint(f\"\u4f60\u597d\uff0c{name}\uff01\")  # \u4f60\u597d\uff0c\u4e16\u754c\uff01\n</code></pre>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/04/25/python-tips/#3","title":"3. \u8f7b\u677e\u89e3\u5305","text":"<pre><code>first, *middle, last = [1, 2, 3, 4, 5]\nprint(first)   # 1\nprint(middle)  # [2, 3, 4]\nprint(last)    # 5\n</code></pre>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/04/25/python-tips/#4-zip","title":"4. \u4f7f\u7528 <code>zip</code> \u914d\u5bf9\u8fed\u4ee3","text":"<pre><code>names = [\"\u5f20\u4e09\", \"\u674e\u56db\", \"\u738b\u4e94\"]\nscores = [85, 92, 78]\n\nfor name, score in zip(names, scores):\n    print(f\"{name}\uff1a{score}\")\n</code></pre>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/04/25/python-tips/#5","title":"5. \u6d77\u8c61\u8fd0\u7b97\u7b26\uff08<code>:=</code>\uff09","text":"<pre><code># Python 3.8+\nif (n := len(data)) &gt; 10:\n    print(f\"\u6570\u636e\u592a\u957f\u4e86\uff1a\u5171 {n} \u9879\")\n</code></pre> <p>\u8fd9\u4e9b\u5c0f\u6280\u5de7\u79ef\u7d2f\u8d77\u6765\uff0c\u80fd\u5927\u5e45\u63d0\u5347\u4ee3\u7801\u7684\u53ef\u8bfb\u6027\u548c\u6548\u7387\u3002</p>","tags":["python","\u6280\u5de7"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/","title":"\u7528 MkDocs \u548c GitHub Pages \u642d\u5efa\u535a\u5ba2","text":"<p>\u4e00\u4efd\u521b\u5efa\u7c7b\u4f3c\u672c\u535a\u5ba2\u7684\u9759\u6001\u535a\u5ba2\u7684\u5206\u6b65\u6307\u5357\u3002</p>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#_1","title":"\u51c6\u5907\u5de5\u4f5c","text":"<ul> <li>Python 3.8 \u6216\u66f4\u9ad8\u7248\u672c</li> <li>Git</li> <li>\u4e00\u4e2a GitHub \u8d26\u6237</li> </ul>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#1-mkdocs-material","title":"\u7b2c 1 \u6b65\uff1a\u5b89\u88c5 MkDocs Material","text":"<pre><code>pip install mkdocs mkdocs-material mkdocs-rss-plugin\n</code></pre>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#2","title":"\u7b2c 2 \u6b65\uff1a\u521b\u5efa\u65b0\u9879\u76ee","text":"<pre><code>mkdocs new my-blog\ncd my-blog\n</code></pre>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#3","title":"\u7b2c 3 \u6b65\uff1a\u914d\u7f6e\u535a\u5ba2\u63d2\u4ef6","text":"<p>\u5728 <code>mkdocs.yml</code> \u4e2d\u6dfb\u52a0\u535a\u5ba2\u63d2\u4ef6\uff1a</p> <pre><code>plugins:\n  - blog:\n      blog_dir: blog\n      post_dir: blog/posts\n</code></pre>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#4","title":"\u7b2c 4 \u6b65\uff1a\u5199\u7b2c\u4e00\u7bc7\u6587\u7ae0","text":"<p>\u5728 <code>docs/blog/posts/</code> \u4e2d\u521b\u5efa\u4e00\u4e2a\u5e26 frontmatter \u7684 Markdown \u6587\u4ef6\uff1a</p> <pre><code>---\ndate: 2024-03-10\ncategories:\n  - \u6280\u672f\n---\n</code></pre>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/2026/05/05/building-blog-with-mkdocs/#5-github-pages","title":"\u7b2c 5 \u6b65\uff1a\u90e8\u7f72\u5230 GitHub Pages","text":"<pre><code>mkdocs gh-deploy --force\n</code></pre> <p>\u641e\u5b9a\uff01\u4f60\u7684\u535a\u5ba2\u73b0\u5728\u5df2\u7ecf\u4e0a\u7ebf\u4e86\uff0c\u8bbf\u95ee\u5730\u5740\u662f <code>https://&lt;\u7528\u6237\u540d&gt;.github.io/&lt;\u4ed3\u5e93\u540d&gt;/</code>\u3002</p> <p>\u642d\u5efa\u535a\u5ba2\u4ece\u672a\u5982\u6b64\u7b80\u5355\u3002\u795d\u4f60\u5199\u4f5c\u6109\u5feb\uff01</p>","tags":["mkdocs","github-pages","\u6559\u7a0b"]},{"location":"blog/archive/2026/05/","title":"2026\u5e7405\u6708","text":""},{"location":"blog/archive/2026/04/","title":"2026\u5e7404\u6708","text":""},{"location":"blog/category/%E6%8A%80%E6%9C%AF/","title":"\u6280\u672f","text":""},{"location":"blog/category/web/","title":"web","text":""},{"location":"blog/category/python/","title":"python","text":""}]}